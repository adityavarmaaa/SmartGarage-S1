# Export values in the process environment before running the setup or services.
DATABASE_URL=
S2_API_KEY=
SP_ACTIVE_ENCRYPTION_KEY=
SP_ENCRYPTION_KEYS=
SP_HMAC_KEY=
# Optional S2 rotating HMAC keys. Keep SP_HMAC_KEY for S1.
SP_ACTIVE_HMAC_KEY=
SP_HMAC_KEYS=
# Use a dedicated local PostgreSQL development role for full mode and quick tests.
# Preview requires no DATABASE_URL or Service 2 API key. OCR can require plate protection keys.
